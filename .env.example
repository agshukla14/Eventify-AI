# Google Gemini API Key (Required for AI generation, budget optimizer & chat)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication Secret (REQUIRED in production; must be at least 32 cryptographically random chars)
JWT_SECRET=eventify-ai-production-secret-signing-key-replace-in-production

# App Environment (development | production)
APP_ENV=development
PORT=8000
FRONTEND_PORT=5173

# Allowed CORS Origins (comma-separated, no wildcards when credentials enabled)
# In development: defaults to localhost:5173, localhost:8000
# In production: set to your deployed frontend domain
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Database URL
# For local development (SQLite):
DATABASE_URL=sqlite:///./celebration_planner.db
# For production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Default Currency
DEFAULT_CURRENCY=INR
